From 6ba896384dd06e2759254fd4d1c8f19ba97e393c Mon Sep 17 00:00:00 2001
From: mptfire <263163432+mptfire@users.noreply.github.com>
Date: Mon, 2 Nov 2026 15:57:09 +0100
Subject: [PATCH 08/22] web_fetch: the html stripper stops leaking tag names

html_to_text pushed each open noisy tag's lowercased name with
String::leak to satisfy a &'static str stack: every <svg>, <script>,
<style>, <noscript>, and <head> on a fetched page leaked an allocation
for the life of the process, and a noisy page is attacker-chosen
content. The stack never reads its entries, so it is a plain Vec<String>
now: dropped with the call. No behavior change; the stripper tests
pass unchanged.
---
 gertie-tools/src/web.rs | 7 +++++--
 1 file changed, 5 insertions(+), 2 deletions(-)

diff --git a/gertie-tools/src/web.rs b/gertie-tools/src/web.rs
index c59fccf..1c3f698 100644
--- a/gertie-tools/src/web.rs
+++ b/gertie-tools/src/web.rs
@@ -31,7 +31,10 @@ fn html_to_text(html: &str) -> String {
     };
 
     let mut out = String::new();
-    let mut skip: Vec<&'static str> = Vec::new();
+    // Local stack of open noisy tags: names only, dropped with the
+    // call, so a page of ten thousand <svg> tags allocates ten
+    // thousand short strings for the duration, not forever.
+    let mut skip: Vec<String> = Vec::new();
     let mut rest = html;
     while let Some(lt) = rest.find('<') {
         if skip.is_empty() {
@@ -63,7 +66,7 @@ fn html_to_text(html: &str) -> String {
                     if closing {
                         skip.pop();
                     } else if !name_part.ends_with('/') {
-                        skip.push(name.leak() as &'static str);
+                        skip.push(name);
                     }
                 } else if block_tag(&name) && skip.is_empty() {
                     out.push('\n');
