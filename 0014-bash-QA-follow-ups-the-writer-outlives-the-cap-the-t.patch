+                            match stream.read(&mut chunk) {
+                                Ok(0) | Err(_) => break,
+                                Ok(n) => {
+                                    let mut buf = buf.lock().unwrap();
+                                    if buf.len() < DRAIN_CAP {
+                                        let room = DRAIN_CAP - buf.len();
+                                        let take = n.min(room);
+                                        buf.extend_from_slice(&chunk[..take]);
