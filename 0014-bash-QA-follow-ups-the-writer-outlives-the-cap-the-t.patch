+            drain(child.stdout.take(), stdout_buf.clone(), done_tx.clone());
+            drain(child.stderr.take(), stderr_buf.clone(), done_tx);
+            // The channel counts the drains: both senders dropped
+            // means both streams are at EOF.
+
