From 66d8eab9a8245c4e43037802bfeec8998c8baf74 Mon Sep 17 00:00:00 2001
From: mptfire <263163432+mptfire@users.noreply.github.com>
Date: Mon, 2 Nov 2026 15:54:02 +0100
Subject: [PATCH 06/22] sandbox: no network inside the sandbox (Landlock ABI
 v4)

The sandbox handled filesystem accesses only, and Landlock's default
for unhandled accesses is allow: a sandboxed command dialed anywhere,
and auto mode's premise (contained work needs no chaperone) did not
hold against exfil. The ruleset now also handles the network half
(AccessNet, ABI v4): no rules, so every connect and bind inside the
sandbox is refused, same HardRequirement ladder as the filesystem
half: a kernel that cannot enforce the network rules (6.7+) fails the
spawn instead of running the command unrestricted.

The probe uses bash's /dev/tcp so the test needs no network tool
installed; on a pre-6.7 kernel the ruleset refuses to build and the
test records a skip.
---
 config.example.toml         |  7 +++--
 gertie-tools/src/sandbox.rs | 60 ++++++++++++++++++++++++++++++++-----
 gertie/src/config.rs        |  6 ++--
 3 files changed, 61 insertions(+), 12 deletions(-)

diff --git a/config.example.toml b/config.example.toml
index 444ae77..b77f62d 100644
--- a/config.example.toml
+++ b/config.example.toml
@@ -43,9 +43,10 @@ api_key_env = "MY_API_KEY"
 # url = "https://mcp.example.com/mcp"
 
 # Security posture. sandbox_bash = true Landlock-isolates bash children:
-# system read-only, writes limited to the workspace and /tmp. Opt-in;
-# when the kernel can't enforce it, sandboxed commands fail rather than
-# run free.
+# system read-only, writes limited to the workspace and /tmp, and no
+# network (connects and binds are refused, so an approved command cannot
+# phone home). Opt-in; when the kernel can't enforce it (the network
+# half wants 6.7+), sandboxed commands fail rather than run free.
 # [security]
 # sandbox_bash = true
 
diff --git a/gertie-tools/src/sandbox.rs b/gertie-tools/src/sandbox.rs
index b879d78..07ee1c5 100644
--- a/gertie-tools/src/sandbox.rs
+++ b/gertie-tools/src/sandbox.rs
@@ -6,15 +6,18 @@
 //! misbehave (or were approved carelessly).
 //!
 //! Posture, fail-closed on purpose: read access to the system, write
-//! access to the workspace and /tmp only. When the kernel can't enforce
-//! (too old, blocked in a container), the spawn **fails**, gertie
-//! never runs a sandboxed command unsandboxed just because the sandbox
-//! was unavailable. `CompatLevel::HardRequirement` is what makes that
-//! guarantee: best-effort would silently downgrade to no sandbox.
+//! access to the workspace and /tmp only, and no network at all (ABI
+//! v4, kernel 6.7+): handled, no rules, connects and binds are
+//! refused, so an approved command is not an approved exfil. When the
+//! kernel can't enforce (too old, blocked in a container), the spawn
+//! **fails**, gertie never runs a sandboxed command unsandboxed just
+//! because the sandbox was unavailable. `CompatLevel::HardRequirement`
+//! is what makes that guarantee: best-effort would silently downgrade
+//! to no sandbox.
 
 use landlock::{
-    ABI, Access, AccessFs, CompatLevel, Compatible, Ruleset, RulesetAttr, RulesetCreatedAttr,
-    RulesetError, RulesetStatus, path_beneath_rules,
+    ABI, Access, AccessFs, AccessNet, CompatLevel, Compatible, Ruleset, RulesetAttr,
+    RulesetCreatedAttr, RulesetError, RulesetStatus, path_beneath_rules,
 };
 use std::os::unix::process::CommandExt;
 use std::path::{Path, PathBuf};
@@ -66,6 +69,15 @@ fn enforce(root: &Path) -> Result<(), String> {
         Ruleset::default()
             .set_compatibility(CompatLevel::HardRequirement)
             .handle_access(AccessFs::from_all(ABI::V1))?
+            // The network half, ABI v4 (kernel 6.7+): handled, no
+            // rules, so every connect and bind is refused. An approved
+            // command is not an approved exfil; without this the
+            // sandbox was a filesystem-write jail and a sandboxed
+            // `curl` dialed anywhere. Same HardRequirement ladder as
+            // the filesystem half: a kernel that cannot enforce the
+            // network rules fails the spawn instead of running it
+            // unrestricted.
+            .handle_access(AccessNet::from_all(ABI::V4))?
             .create()?
             .add_rules(path_beneath_rules(
                 existing_readonly,
@@ -132,4 +144,38 @@ mod tests {
         assert!(!std::path::Path::new("/etc/gertie-sandbox-test").exists());
         assert!(!output.status.success());
     }
+
+    /// An approved command must not be an approved exfil: with the
+    /// network half handled, an outbound connection from inside the
+    /// sandbox is refused (EACCES on the connect), so a sandboxed
+    /// `curl` cannot phone home. Uses bash's /dev/tcp so the probe
+    /// needs no network tool installed. Needs a Landlock-4 kernel
+    /// (6.7+); older kernels fail the spawn and the test skips.
+    #[test]
+    fn sandboxed_children_cannot_open_network_connections() {
+        let tmp = tempfile::tempdir().unwrap();
+        let mut cmd = std::process::Command::new("bash");
+        cmd.arg("-c")
+            .arg("exec 3<>/dev/tcp/1.1.1.1/80 && echo OPENED")
+            .current_dir(tmp.path());
+        if Sandbox::new(tmp.path().to_path_buf()).apply(&mut cmd).is_err() {
+            eprintln!("skipped: sandbox unavailable");
+            return;
+        }
+        let output = match cmd.output() {
+            Ok(output) => output,
+            // The ruleset refused to build (kernel without network
+            // support): fail-closed, recorded as skipped here.
+            Err(_) => {
+                eprintln!("skipped: kernel cannot enforce network rules");
+                return;
+            }
+        };
+        let stdout = String::from_utf8_lossy(&output.stdout);
+        assert!(
+            !stdout.contains("OPENED"),
+            "the sandboxed connect succeeded: {stdout}"
+        );
+        assert!(!output.status.success(), "{output:?}");
+    }
 }
diff --git a/gertie/src/config.rs b/gertie/src/config.rs
index c27aba8..5bd85c3 100644
--- a/gertie/src/config.rs
+++ b/gertie/src/config.rs
@@ -79,8 +79,10 @@ pub struct WorktreeConfig {
 #[derive(Deserialize, Debug, Clone, Default)]
 pub struct SecurityConfig {
     /// Landlock-isolate bash children: system reads, workspace//tmp
-    /// writes only. Opt-in; when the kernel can't enforce it, sandboxed
-    /// commands fail instead of running free. `Some` = the user's file
+    /// writes, and no network at all (connects and binds are
+    /// refused). Opt-in; when the kernel can't enforce it (the
+    /// network half wants 6.7+), sandboxed commands fail instead of
+    /// running free. `Some` = the user's file
     /// set it; `None` = unset, a lower tier decides.
     #[serde(default)]
     pub sandbox_bash: Option<bool>,
-- 
